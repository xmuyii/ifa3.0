# Which AI provider powers the strategist. Defaults to anthropic if unset.
# Switching is just changing this value in Railway's environment variables —
# no code change, no rebuild needed.
AI_PROVIDER=anthropic

# --- Anthropic (used when AI_PROVIDER=anthropic) ---
# Get this from https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional — override the default model:
# ANTHROPIC_MODEL=claude-sonnet-5

# --- DeepSeek (used when AI_PROVIDER=deepseek) ---
# Get this from https://platform.deepseek.com -> API Keys
DEEPSEEK_API_KEY=sk-...
# Optional — override the default model (deepseek-chat or deepseek-reasoner):
# DEEPSEEK_MODEL=deepseek-chat

# The passphrase for the hidden admin stats panel — typed into the small,
# unlabeled text field at the very bottom of Settings. Pick something only
# you would type; it is never shown or hinted at anywhere in the app.
ADMIN_PASSPHRASE=choose-something-only-you-know

# Set the real values in your hosting provider's environment variables — never commit them.

# --- Gemini (used when AI_PROVIDER=gemini) ---
# Get this from https://aistudio.google.com -> Get API Key
GEMINI_API_KEY=...
# Optional — override the default model:
# GEMINI_MODEL=gemini-2.5-flash
